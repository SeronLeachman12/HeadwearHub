<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

    <body>
        <%- include('partials/header') %>

            <main class="container">
                <div class="auth-container animate-fade-in text-center">
                    <h2 style="margin-bottom: 0.5rem; font-size: 2rem;">Welcome Back</h2>
                    <p style="color: var(--text-muted); margin-bottom: 2rem;">Log in to your Headwear Hub account</p>

                    <form id="loginForm">
                        <div class="form-group">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" placeholder="name@example.com" required>
                        </div>

                        <div class="form-group">
                            <label for="psw">Password</label>
                            <div style="position: relative;">
                                <input type="password" id="psw" placeholder="••••••••" required>
                                <span id="togglePsw"
                                    style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); cursor: pointer; opacity: 0.6;">👁️</span>
                            </div>
                        </div>

                        <div class="form-group"
                            style="display: flex; align-items: center; gap: 0.5rem; text-align: left;">
                            <input type="checkbox" id="rememberMe" style="width: auto;">
                            <label for="rememberMe" style="margin-bottom: 0; cursor: pointer;">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Sign
                            In</button>

                        <p style="margin-top: 2rem; font-size: 0.9rem; color: var(--text-muted);">
                            Don't have an account? <a href="/register"
                                style="color: var(--primary-color); font-weight: 600;">Create one</a>
                        </p>
                    </form>
                </div>
            </main>

            <%- include('partials/footer') %>

                <script>
                    const togglePsw = document.getElementById('togglePsw');
                    const pswInput = document.getElementById('psw');

                    togglePsw.addEventListener('click', () => {
                        const type = pswInput.getAttribute('type') === 'password' ? 'text' : 'password';
                        pswInput.setAttribute('type', type);
                        togglePsw.textContent = type === 'password' ? '👁️' : '🙈';
                    });

                    const loginForm = document.getElementById("loginForm");
                    loginForm.addEventListener("submit", function (e) {
                        e.preventDefault();
                        const email = document.getElementById("email").value;
                        const password = document.getElementById("psw").value;
                        const remember = document.getElementById("rememberMe").checked;
                        const savedUser = JSON.parse(localStorage.getItem("user"));

                        if (!savedUser) {
                            alert("No registered account found. Please register first.");
                            return;
                        }

                        if (email === savedUser.email && password === savedUser.password) {
                            localStorage.setItem("loggedIn", "true");
                            localStorage.setItem("user", JSON.stringify(savedUser));
                            alert("Login Successful!");
                            window.location.href = "/";
                        } else {
                            alert("Incorrect email or password.");
                        }
                    });
                </script>
    </body>

</html>