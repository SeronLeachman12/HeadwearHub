<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

    <body>
        <%- include('partials/header') %>

            <main>
                <section class="hero animate-fade-in">
                    <div class="container">
                        <h1>Redefine Your Headwear <br><span style="color: var(--primary-color)">Experience</span></h1>
                        <p>Premium caps, beanies, and hats designed for those who value style and quality above all
                            else.</p>
                        <div style="display: flex; gap: 1rem; justify-content: center;">
                            <a href="/shop" class="btn btn-primary">Shop Collection</a>
                            <a href="/about" class="btn btn-outline">Our Story</a>
                        </div>
                    </div>
                </section>

                <section class="container" style="padding: 4rem 2rem;">
                    <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">Featured Categories</h2>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                        <div class="card">
                            <div
                                style="height: 200px; background: #2a2a2a; border-radius: 8px; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
                                <span style="font-size: 3rem;">🧢</span>
                            </div>
                            <h3>Classic Caps</h3>
                            <p style="color: var(--text-muted); margin: 0.5rem 0 1.5rem;">Timeless designs for everyday
                                wear.</p>
                            <a href="/shop?cat=caps" class="btn btn-outline" style="width: 100%;">Explore</a>
                        </div>
                        <div class="card">
                            <div
                                style="height: 200px; background: #2a2a2a; border-radius: 8px; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
                                <span style="font-size: 3rem;">🧶</span>
                            </div>
                            <h3>Luxury Beanies</h3>
                            <p style="color: var(--text-muted); margin: 0.5rem 0 1.5rem;">Stay warm with premium
                                fabrics.</p>
                            <a href="/shop?cat=beanies" class="btn btn-outline" style="width: 100%;">Explore</a>
                        </div>
                        <div class="card">
                            <div
                                style="height: 200px; background: #2a2a2a; border-radius: 8px; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
                                <span style="font-size: 3rem;">🎩</span>
                            </div>
                            <h3>Exclusive Fedoras</h3>
                            <p style="color: var(--text-muted); margin: 0.5rem 0 1.5rem;">Make a statement with our
                                elite range.</p>
                            <a href="/shop?cat=fedoras" class="btn btn-outline" style="width: 100%;">Explore</a>
                        </div>
                    </div>
                </section>
            </main>

            <%- include('partials/footer') %>
    </body>

</html>